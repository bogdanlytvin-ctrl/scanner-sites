# Database (SQLite — relative path for Railway)
DATABASE_URL=file:./prisma/dev.db

# Optional: Google PageSpeed Insights API key
# Without key: 25 req/day. With key: 25,000 req/day
# Get free key: https://console.cloud.google.com → PageSpeed Insights API
# GOOGLE_PAGESPEED_API_KEY=AIza...

# Optional: Telegram notifications
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
