{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scanner-sites",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  // nodejs_compat is REQUIRED: src/app/api/analyze uses node:dns / node:net
  // (the SSRF guard in src/lib/ssrf.ts). Without it the analyze route breaks.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
